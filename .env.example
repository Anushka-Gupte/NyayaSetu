PROJECT_NAME="NyayaSetu - Court Case Scheduling & Hearing Management System"
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_super_secure_random_key_in_production_32bytes_minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Configuration (Defaults to SQLite for local development; switch to PostgreSQL anytime)
DATABASE_URL=sqlite+aiosqlite:///./nyayasetu.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/nyayasetu

# Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Virtual Courtroom & Transcription
VIRTUAL_COURT_BASE_URL=https://meet.jit.si
WHISPER_MODEL_SIZE=base
